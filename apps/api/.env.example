# Local PostgreSQL for the API and the persistent public world.
DATABASE_URL="postgresql://postgres@localhost:5432/monsters?schema=public"

# Integration tests use their own database. Defaults to DATABASE_URL + "_test".
# TEST_DATABASE_URL="postgresql://postgres@localhost:5432/monsters_test?schema=public"

# Shadow database, only needed for `prisma migrate dev` / `prisma migrate diff`.
# SHADOW_DATABASE_URL="postgresql://postgres@localhost:5432/monsters_shadow"

PORT=3101

# Comma separated list of allowed browser origins for REST and WebSocket CORS.
WEB_ORIGIN="http://localhost:3100"

# Better Auth. Generate the secret with: openssl rand -base64 32
# Production URLs:
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="https://api.monstersdna.com"
# AUTH_COOKIE_DOMAIN=".monstersdna.com"

# Google OAuth callback URL:
# https://api.monstersdna.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Resend magic links. The from-address must use a verified Resend domain.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="MonstersDNA <login@monstersdna.com>"

# Set to "false" to boot the API without owning or ticking the public world.
# WORLD_RUNNER_ENABLED=true

# Wild monsters created the first time the world is seeded. Ten by default;
# raise it only for load testing a fresh database.
# WORLD_SEED_POPULATION=100

# New anonymous guests allowed per minute. Raise it only for load testing.
# GUEST_BOOTSTRAP_LIMIT=10
