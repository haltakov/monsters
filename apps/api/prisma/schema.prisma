generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Better Auth identity. `role` is intentionally changed only in PostgreSQL.
model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          String        @default("user")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  guestDevices  GuestPlayer[]
  monsters      Monster[]     @relation("AccountMonsterOwner")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

/// Anonymous device-bound identity. Only a hash of the bearer token is stored.
model GuestPlayer {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  displayName String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lastSeenAt  DateTime      @default(now())
  /// Set while this browser identity is attached to a signed-in account.
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  monsters    Monster[]
  memberships WorldMember[]

  @@index([userId])
}

model World {
  id          String         @id @default(cuid())
  /// Stable human key. The permanent public world uses "public".
  slug        String         @unique
  name        String
  seed        Int
  isPublic    Boolean        @default(true)
  status      String         @default("active")
  settings    Json           @default("{}")
  /// Authoritative tick of the latest checkpoint.
  currentTick Int            @default(0)
  /// Wall-clock instant the latest checkpoint corresponds to.
  simulatedAt DateTime       @default(now())
  /// Durable daily reset deadline. Initialized at rollout, then advanced atomically.
  nextResetAt DateTime?
  monsters    Monster[]
  members     WorldMember[]
  snapshot    WorldSnapshot?
  events      WorldEvent[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WorldMember {
  id                String      @id @default(cuid())
  world             World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId           String
  guest             GuestPlayer @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId           String
  /// Owned monster the guest currently controls, if any.
  selectedMonsterId String?
  lastSeenAt        DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([worldId, guestId])
  @@index([guestId])
}

model Monster {
  id             String       @id @default(cuid())
  name           String
  /// Unicode-normalized, case-folded player nickname. Wild names may repeat.
  nicknameKey    String?      @unique
  species        String
  /// Versioned deterministic DNA document.
  dna            Json
  position       Json?
  energy         Int          @default(100)
  ageSeconds     Float        @default(0)
  world          World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId        String
  owner          GuestPlayer? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId        String?
  /// Permanent signed-in history owner; local control remains device-bound.
  accountOwner   User?        @relation("AccountMonsterOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  accountOwnerId String?
  /// player, mating, wild, admin or copy.
  originType     String       @default("wild")
  clonedFromId   String?
  generation     Int          @default(0)
  parentAId      String?
  parentBId      String?
  mutations      Int          @default(0)
  alive          Boolean      @default(true)
  diedAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([worldId])
  @@index([ownerId])
  @@index([accountOwnerId])
  @@index([originType])
  @@index([worldId, alive])
}

/// Latest authoritative recovery snapshot for a world.
model WorldSnapshot {
  id          String   @id @default(cuid())
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId     String   @unique
  version     Int
  tick        Int
  simulatedAt DateTime
  state       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Append-only semantic history for diagnostics and player-visible history.
model WorldEvent {
  id        String   @id @default(cuid())
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId   String
  tick      Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([worldId, createdAt])
  @@index([worldId, type])
}
