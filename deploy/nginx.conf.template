server {
  listen 3000;
  listen [::]:3000;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;
  # TLS terminates at Coolify/Cloudflare. Relative directory redirects preserve
  # the public HTTPS origin instead of exposing http://host:3000/privacy/.
  absolute_redirect off;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    application/javascript
    application/json
    application/wasm
    image/svg+xml
    text/css
    text/javascript
    text/plain;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location /_next/static/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ $uri.html =404;
  }
  # Proxy the site-specific v4 script from Plausible. p.monstersdna.com only
  # supports the legacy script path; it is used directly by browsers for events.
  # Do not chain event requests through Nginx: p uses its connecting client IP,
  # which would turn all visitors into this server and trigger bot filtering.
  # Docker's embedded resolver refreshes upstream addresses without a restart.
  resolver 127.0.0.11 ipv6=off valid=60s;
  set $plausible_script_id "${PLAUSIBLE_SCRIPT_ID}";
  set $plausible_origin "https://plausible.io";
  proxy_ssl_server_name on;
  proxy_ssl_name plausible.io;
  proxy_ssl_verify on;
  # Plausible's CDN uses a cross-signed certificate chain; Nginx's default
  # verification depth of 1 rejects it even with the current CA bundle.
  proxy_ssl_verify_depth 4;
  proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
  proxy_http_version 1.1;
  proxy_connect_timeout 5s;
  proxy_read_timeout 10s;

  proxy_set_header Host plausible.io;
  proxy_set_header Connection "";
  proxy_set_header Cookie "";
  proxy_set_header Authorization "";
  proxy_set_header Referer "";
  proxy_set_header Origin "";
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $host;
  proxy_hide_header Set-Cookie;
  proxy_hide_header Access-Control-Allow-Origin;
  proxy_hide_header Access-Control-Allow-Credentials;
  proxy_hide_header Report-To;
  proxy_hide_header NEL;

  add_header X-Content-Type-Options nosniff always;

  location = /js/script.js {
    access_log off;
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    if ($plausible_script_id = "") { return 503; }
    proxy_pass $plausible_origin/js/$plausible_script_id.js;
  }

  location = /api/event {
    access_log off;
    if ($request_method = OPTIONS) { return 204; }
    if ($request_method != POST) { return 405; }
    if ($plausible_script_id = "") { return 503; }
    client_max_body_size 16k;
    # Compatibility for clients with an older cached bundle. Forward directly
    # to Plausible, preserving the visitor chain rather than using the p proxy.
    add_header Cache-Control "no-store" always;
    proxy_pass $plausible_origin/api/event;
  }

}
