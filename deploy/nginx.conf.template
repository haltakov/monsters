server {
  listen 3000;
  listen [::]:3000;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    application/javascript
    application/json
    application/wasm
    image/svg+xml
    text/css
    text/javascript
    text/plain;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location /_next/static/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ $uri.html =404;
  }
}

# Same deployment, separate first-party analytics host. Never serve the game
# from this host or proxy arbitrary upstream URLs. Coolify routes both hosts
# to port 3000; TLS is terminated by its reverse proxy.
server {
  listen 3000;
  listen [::]:3000;
  server_name p.monstersdna.com;
  server_tokens off;
  access_log off;

  # Docker's embedded resolver refreshes upstream addresses without a restart.
  resolver 127.0.0.11 ipv6=off valid=60s;
  set $plausible_script_id "${PLAUSIBLE_SCRIPT_ID}";
  set $plausible_origin "https://plausible.io";
  proxy_ssl_server_name on;
  proxy_ssl_name plausible.io;
  proxy_ssl_verify on;
  proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
  proxy_http_version 1.1;
  proxy_connect_timeout 5s;
  proxy_read_timeout 10s;

  proxy_set_header Host plausible.io;
  proxy_set_header Connection "";
  proxy_set_header Cookie "";
  proxy_set_header Authorization "";
  proxy_set_header Referer "";
  proxy_set_header Origin "";
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $host;
  proxy_hide_header Set-Cookie;
  proxy_hide_header Access-Control-Allow-Origin;
  proxy_hide_header Access-Control-Allow-Credentials;

  add_header Access-Control-Allow-Origin "https://monstersdna.com" always;
  add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
  add_header Access-Control-Allow-Headers "Content-Type" always;
  add_header X-Content-Type-Options nosniff always;

  location = /js/script.js {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    if ($plausible_script_id = "") { return 503; }
    proxy_pass $plausible_origin/js/$plausible_script_id.js;
  }

  location = /api/event {
    if ($request_method = OPTIONS) { return 204; }
    if ($request_method != POST) { return 405; }
    if ($plausible_script_id = "") { return 503; }
    client_max_body_size 16k;
    proxy_pass $plausible_origin/api/event;
  }

  location / { return 404; }
}
